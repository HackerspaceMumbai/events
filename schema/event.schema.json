{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackmum.in/schema/event.schema.json",
  "title": "Hackerspace Mumbai event metadata",
  "description": "Contract for events/**/event.yml. Consumed by this archive's CI and, later, by hackmum.in.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "title",
    "slug",
    "date",
    "city",
    "country",
    "eventType",
    "series",
    "community",
    "venue",
    "website",
    "eventPage",
    "resourcesAvailable"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "enum": [
        "meetup",
        "workshop",
        "conference",
        "hackathon",
        "community-day",
        "series",
        "summit"
      ]
    },
    "series": {
      "description": "Series identifier, or null/empty for a standalone event.",
      "type": ["string", "null"]
    },
    "community": {
      "type": "string",
      "minLength": 1
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "eventPage": {
      "type": "string",
      "format": "uri"
    },
    "resourcesAvailable": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["upcoming", "completed", "cancelled"]
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "startTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string"
    },
    "gallery": {
      "type": "string",
      "format": "uri"
    },
    "assets": {
      "description": "Relative paths to organizer-owned visual identity files under the event folder.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cover": {
          "description": "Path relative to the event folder, e.g. media/cover.jpg",
          "type": "string",
          "minLength": 1
        },
        "banner": {
          "description": "Optional path relative to the event folder, e.g. media/banner.jpg",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
